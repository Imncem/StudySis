rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isDashboardAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function validPercent(value) {
      return value is int && value >= 0 && value <= 100;
    }

    function validCount(value) {
      return value is int && value >= 0;
    }

    function optionalBool(data, field) {
      return !data.keys().hasAny([field]) || data[field] is bool;
    }

    function optionalCount(data, field) {
      return !data.keys().hasAny([field]) || validCount(data[field]);
    }

    function optionalNullableCount(data, field) {
      return !data.keys().hasAny([field])
        || data[field] == null
        || validCount(data[field]);
    }

    function optionalPercent(data, field) {
      return !data.keys().hasAny([field]) || validPercent(data[field]);
    }

    function optionalTimestamp(data, field) {
      return !data.keys().hasAny([field])
        || data[field] == null
        || data[field] is timestamp;
    }

    function optionalConstant(data, field, value) {
      return !data.keys().hasAny([field])
        || data[field] == null
        || data[field] == value;
    }

    function validChapterProgress(uid) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'studentProfileId', 'subjectId', 'chapterId',
          'learnCompleted', 'learnCompletedAt',
          'flashcardsMasteredCount', 'flashcardsTotalCount',
          'flashcardsCompleted', 'masteredFlashcardIds',
          'practiceLatestPercentage', 'practiceBestPercentage',
          'practiceCorrectCount', 'practiceTotalQuestions',
          'practiceCompletedAt',
          'quizLatestPercentage', 'quizBestPercentage',
          'quizCorrectCount', 'quizIncorrectCount', 'quizUnansweredCount',
          'quizPassed', 'quizCompletedAt',
          'overallProgress', 'lastActivityAt', 'createdAt', 'updatedAt'
        ])
        && data.studentProfileId == 'qidah'
        && data.subjectId is string
        && data.subjectId.size() > 0
        && data.chapterId is string
        && data.chapterId.size() > 0
        && optionalBool(data, 'learnCompleted')
        && optionalTimestamp(data, 'learnCompletedAt')
        && optionalCount(data, 'flashcardsMasteredCount')
        && optionalCount(data, 'flashcardsTotalCount')
        && optionalBool(data, 'flashcardsCompleted')
        && (!data.keys().hasAny(['masteredFlashcardIds']) || data.masteredFlashcardIds is list)
        && optionalPercent(data, 'practiceLatestPercentage')
        && optionalPercent(data, 'practiceBestPercentage')
        && optionalCount(data, 'practiceCorrectCount')
        && optionalCount(data, 'practiceTotalQuestions')
        && optionalTimestamp(data, 'practiceCompletedAt')
        && optionalPercent(data, 'quizLatestPercentage')
        && optionalPercent(data, 'quizBestPercentage')
        && optionalCount(data, 'quizCorrectCount')
        && optionalCount(data, 'quizIncorrectCount')
        && optionalCount(data, 'quizUnansweredCount')
        && optionalBool(data, 'quizPassed')
        && optionalTimestamp(data, 'quizCompletedAt')
        && validPercent(data.overallProgress)
        && data.lastActivityAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validSavedFlashcard() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'subjectId', 'chapterId', 'cardId', 'savedAt'
        ])
        && data.subjectId is string
        && data.subjectId.size() > 0
        && data.chapterId is string
        && data.chapterId.size() > 0
        && data.cardId is string
        && data.cardId.size() > 0
        && data.savedAt is timestamp;
    }

    function validDateKey(value) {
      return value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function validEngagementState() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'totalXp', 'level', 'currentStreak', 'longestStreak',
          'lastQualifiedDate', 'todayDateKey', 'todayStudyPoints',
          'dailyStudyTarget', 'todayStreakSecured', 'creditedActivities',
          'updatedAt'
        ])
        && validCount(data.totalXp)
        && data.level is int
        && data.level >= 1
        && validCount(data.currentStreak)
        && validCount(data.longestStreak)
        && data.longestStreak >= data.currentStreak
        && (data.lastQualifiedDate == null || validDateKey(data.lastQualifiedDate))
        && validDateKey(data.todayDateKey)
        && validCount(data.todayStudyPoints)
        && data.dailyStudyTarget is int
        && data.dailyStudyTarget >= 1
        && data.dailyStudyTarget <= 20
        && data.todayStreakSecured is bool
        && (!data.todayStreakSecured || data.currentStreak >= 1)
        && (!data.keys().hasAny(['creditedActivities']) || data.creditedActivities is map)
        && data.updatedAt is timestamp;
    }

    function validEngagementDay(dateKey) {
      let data = request.resource.data;
      return validDateKey(dateKey)
        && data.keys().hasOnly([
          'studyPoints', 'xpEarned', 'streakSecured', 'qualifiedAt',
          'creditedActivities', 'updatedAt'
        ])
        && validCount(data.studyPoints)
        && validCount(data.xpEarned)
        && data.streakSecured is bool
        && optionalTimestamp(data, 'qualifiedAt')
        && data.creditedActivities is map
        && data.updatedAt is timestamp;
    }

    function validPetCosmeticId(value) {
      return value in [
        'leaf_bow', 'round_glasses', 'star_scarf', 'study_headphones',
        'wizard_hat', 'graduation_cap'
      ];
    }

    function validPetCosmeticSlotForItem(slot, itemId) {
      return (slot == 'head'
          && itemId in [
            'leaf_bow', 'study_headphones', 'wizard_hat', 'graduation_cap'
          ])
        || (slot == 'face' && itemId == 'round_glasses')
        || (slot == 'neck' && itemId == 'star_scarf');
    }

    function petCosmeticSlot(itemId) {
      return itemId == 'round_glasses' ? 'face'
        : itemId == 'star_scarf' ? 'neck'
        : 'head';
    }

    function petCosmeticPrice(itemId) {
      return itemId == 'leaf_bow' ? 30
        : itemId == 'round_glasses' ? 40
        : itemId == 'star_scarf' ? 50
        : itemId == 'study_headphones' ? 70
        : itemId == 'wizard_hat' ? 90
        : itemId == 'graduation_cap' ? 120
        : -1;
    }

    function validPetEconomyShape(data) {
      return data.keys().hasOnly([
          'schemaVersion', 'pawCoins', 'lifetimePawCoinsEarned',
          'totalPawCoinsSpent', 'creditedCoinActivities',
          'ownedCosmeticIds', 'equippedCosmetics', 'lastPurchasedItemId',
          'lastPurchasedAt', 'updatedAt'
        ])
        && data.schemaVersion == 1
        && validCount(data.pawCoins)
        && validCount(data.lifetimePawCoinsEarned)
        && validCount(data.totalPawCoinsSpent)
        && data.lifetimePawCoinsEarned >= data.pawCoins + data.totalPawCoinsSpent
        && data.creditedCoinActivities is map
        && data.ownedCosmeticIds is list
        && data.equippedCosmetics is map
        && data.equippedCosmetics.keys().hasOnly(['head', 'face', 'neck'])
        && validEquippedSlot(data, 'head')
        && validEquippedSlot(data, 'face')
        && validEquippedSlot(data, 'neck')
        && (data.lastPurchasedItemId == null
          || validPetCosmeticId(data.lastPurchasedItemId))
        && optionalTimestamp(data, 'lastPurchasedAt')
        && data.updatedAt is timestamp;
    }

    function validEquippedSlot(data, slot) {
      return data.equippedCosmetics[slot] == null
        || (validPetCosmeticId(data.equippedCosmetics[slot])
          && validPetCosmeticSlotForItem(slot, data.equippedCosmetics[slot])
          && data.equippedCosmetics[slot] in data.ownedCosmeticIds);
    }

    function validPetEconomyDefaultCreate(stateId) {
      let data = request.resource.data;
      return stateId == 'state'
        && validPetEconomyShape(data)
        && data.pawCoins == 0
        && data.lifetimePawCoinsEarned == 0
        && data.totalPawCoinsSpent == 0
        && data.ownedCosmeticIds.size() == 0
        && data.equippedCosmetics.head == null
        && data.equippedCosmetics.face == null
        && data.equippedCosmetics.neck == null
        && data.lastPurchasedItemId == null
        && data.lastPurchasedAt == null;
    }

    function validPetEconomyEarnCreate(stateId) {
      let data = request.resource.data;
      return stateId == 'state'
        && validPetEconomyShape(data)
        && data.pawCoins > 0
        && data.pawCoins <= 20
        && data.lifetimePawCoinsEarned == data.pawCoins
        && data.totalPawCoinsSpent == 0
        && data.ownedCosmeticIds.size() == 0
        && data.equippedCosmetics.head == null
        && data.equippedCosmetics.face == null
        && data.equippedCosmetics.neck == null
        && data.lastPurchasedItemId == null
        && data.lastPurchasedAt == null
        && data.creditedCoinActivities.size() == 1;
    }

    function validPetEconomyEarnUpdate(stateId) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return stateId == 'state'
        && validPetEconomyShape(after)
        && changed.hasOnly([
          'pawCoins', 'lifetimePawCoinsEarned', 'creditedCoinActivities',
          'updatedAt'
        ])
        && after.pawCoins > before.pawCoins
        && after.pawCoins - before.pawCoins <= 20
        && after.lifetimePawCoinsEarned - before.lifetimePawCoinsEarned
          == after.pawCoins - before.pawCoins
        && after.creditedCoinActivities.size()
          == before.creditedCoinActivities.size() + 1;
    }

    function validPetEconomyPurchaseUpdate(stateId) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      let itemId = after.lastPurchasedItemId;
      let price = petCosmeticPrice(itemId);
      return stateId == 'state'
        && validPetEconomyShape(after)
        && changed.hasOnly([
          'pawCoins', 'totalPawCoinsSpent', 'ownedCosmeticIds',
          'equippedCosmetics', 'lastPurchasedItemId', 'lastPurchasedAt',
          'updatedAt'
        ])
        && validPetCosmeticId(itemId)
        && price > 0
        && !(itemId in before.ownedCosmeticIds)
        && itemId in after.ownedCosmeticIds
        && after.ownedCosmeticIds.size() == before.ownedCosmeticIds.size() + 1
        && before.pawCoins >= price
        && after.pawCoins == before.pawCoins - price
        && after.totalPawCoinsSpent == before.totalPawCoinsSpent + price
        && after.lifetimePawCoinsEarned == before.lifetimePawCoinsEarned
        && after.lastPurchasedAt is timestamp
        && after.equippedCosmetics[petCosmeticSlot(itemId)] == itemId;
    }

    function validPetEconomyEquipmentUpdate(stateId) {
      let after = request.resource.data;
      let changed = after.diff(resource.data).affectedKeys();
      return stateId == 'state'
        && validPetEconomyShape(after)
        && changed.hasOnly(['equippedCosmetics', 'updatedAt'])
        && after.pawCoins == resource.data.pawCoins
        && after.lifetimePawCoinsEarned == resource.data.lifetimePawCoinsEarned
        && after.totalPawCoinsSpent == resource.data.totalPawCoinsSpent;
    }

    function validPetEconomyCreate(stateId) {
      return validPetEconomyDefaultCreate(stateId)
        || validPetEconomyEarnCreate(stateId);
    }

    function validPetEconomyUpdate(stateId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasAny(['lastPurchasedItemId', 'lastPurchasedAt'])
        ? validPetEconomyPurchaseUpdate(stateId)
        : changed.hasOnly(['equippedCosmetics', 'updatedAt'])
          ? validPetEconomyEquipmentUpdate(stateId)
          : validPetEconomyEarnUpdate(stateId);
    }

    function validPetEggId(value) {
      return value in ['egg_spark', 'egg_sprout', 'egg_starlight'];
    }

    function validPetId(value) {
      return value in ['pet_fox', 'pet_bunny', 'pet_cat'];
    }

    function validEggPetMapping(eggId, petId) {
      return (eggId == 'egg_spark' && petId == 'pet_fox')
        || (eggId == 'egg_sprout' && petId == 'pet_bunny')
        || (eggId == 'egg_starlight' && petId == 'pet_cat');
    }

    function validPetName(value) {
      return value is string
        && value.size() >= 2
        && value.size() <= 15;
    }

    function validPetHabitatValue(value) {
      return value in ['forest', 'farm', 'house', 'garden'];
    }

    function validPetHabitat(data) {
      return !data.keys().hasAny(['habitatTheme'])
        || validPetHabitatValue(data.habitatTheme);
    }

    function validPetGrowthStageValue(value) {
      return value in ['hatchling', 'young', 'evolved', 'adult'];
    }

    function validPetGrowth(data) {
      return (!data.keys().hasAny(['growthStage'])
          || data.growthStage == null
          || validPetGrowthStageValue(data.growthStage))
        && optionalNullableCount(data, 'xpBaselineAtHatch')
        && optionalTimestamp(data, 'lastEvolutionAt');
    }

    function petStageRank(stage) {
      return stage == 'unselected' ? 0
        : stage == 'egg' ? 1
        : stage == 'hatchling' ? 2
        : -1;
    }

    function petGrowthStage(data) {
      return data.keys().hasAny(['growthStage']) && data.growthStage != null
        ? data.growthStage
        : 'hatchling';
    }

    function petGrowthStageRank(stage) {
      return stage == 'hatchling' ? 0
        : stage == 'young' ? 1
        : stage == 'evolved' ? 2
        : stage == 'adult' ? 3
        : -1;
    }

    function validPetGrowthTransition(before, after) {
      let from = petGrowthStage(before);
      let to = petGrowthStage(after);
      return (from == 'hatchling' && to == 'young')
        || (from == 'young' && to == 'evolved')
        || (from == 'evolved' && to == 'adult');
    }

    function validPetGrowthRequirement(after, engagement) {
      let to = petGrowthStage(after);
      return after.xpBaselineAtHatch is int
        && after.hatchedAt is timestamp
        && validCount(engagement.totalXp)
        && (
          (to == 'young'
            && engagement.totalXp - after.xpBaselineAtHatch >= 200
            && request.time >= after.hatchedAt + duration.value(48, 'h'))
          || (to == 'evolved'
            && engagement.totalXp - after.xpBaselineAtHatch >= 500
            && request.time >= after.hatchedAt + duration.value(120, 'h'))
          || (to == 'adult'
            && engagement.totalXp - after.xpBaselineAtHatch >= 900
            && request.time >= after.hatchedAt + duration.value(240, 'h'))
        );
    }

    function validStudyPetEvolutionState(data) {
      return data.keys().hasOnly([
          'schemaVersion', 'petUnlockAcknowledgedAt', 'eggId', 'petId',
          'stage', 'selectedAt', 'xpBaselineAtSelection', 'hatchXpTarget',
          'hatchDelayHours', 'hatchedAt', 'petName', 'habitatTheme',
          'growthStage', 'xpBaselineAtHatch', 'lastEvolutionAt', 'updatedAt'
        ])
        && (!data.keys().hasAny(['schemaVersion']) || data.schemaVersion == 1)
        && data.stage == 'hatchling'
        && validPetEggId(data.eggId)
        && validPetId(data.petId)
        && validEggPetMapping(data.eggId, data.petId)
        && data.hatchedAt is timestamp
        && validPetName(data.petName)
        && validPetHabitat(data)
        && validPetGrowth(data)
        && data.xpBaselineAtHatch is int
        && data.updatedAt is timestamp
        && optionalTimestamp(data, 'petUnlockAcknowledgedAt')
        && optionalTimestamp(data, 'selectedAt')
        && optionalNullableCount(data, 'xpBaselineAtSelection')
        && optionalConstant(data, 'hatchXpTarget', 100)
        && optionalConstant(data, 'hatchDelayHours', 24);
    }

    function validStudyPetState() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'schemaVersion', 'petUnlockAcknowledgedAt', 'eggId', 'petId',
          'stage', 'selectedAt', 'xpBaselineAtSelection', 'hatchXpTarget',
          'hatchDelayHours', 'hatchedAt', 'petName', 'habitatTheme',
          'growthStage', 'xpBaselineAtHatch', 'lastEvolutionAt', 'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.stage in ['unselected', 'egg', 'hatchling']
        && validPetHabitat(data)
        && validPetGrowth(data)
        && optionalTimestamp(data, 'petUnlockAcknowledgedAt')
        && data.hatchXpTarget == 100
        && data.hatchDelayHours == 24
        && data.updatedAt is timestamp
        && (
          (data.stage == 'unselected'
            && data.eggId == null
            && data.petId == null
            && data.selectedAt == null
            && data.xpBaselineAtSelection == null
            && data.hatchedAt == null
            && data.petName == null)
          || (data.stage == 'egg'
            && validPetEggId(data.eggId)
            && data.petId == null
            && data.selectedAt is timestamp
            && validCount(data.xpBaselineAtSelection)
            && data.hatchedAt == null
            && data.petName == null)
          || (data.stage == 'hatchling'
            && validPetEggId(data.eggId)
            && validPetId(data.petId)
            && validEggPetMapping(data.eggId, data.petId)
            && data.selectedAt is timestamp
            && validCount(data.xpBaselineAtSelection)
            && data.hatchedAt is timestamp
            && validPetName(data.petName))
        );
    }

    function validStudyPetCreate(stateId) {
      return stateId == 'state'
        && validStudyPetState()
        && request.resource.data.stage in ['unselected', 'egg'];
    }

    function validStudyPetUpdate(stateId) {
      let before = resource.data;
      let after = request.resource.data;
      let engagement = get(/databases/$(database)/documents/student_progress/$(request.auth.uid)/engagement/state).data;
      return stateId == 'state'
        && validStudyPetState()
        && petStageRank(after.stage) >= petStageRank(before.stage)
        && (before.stage == 'unselected'
          || after.eggId == before.eggId)
        && (before.stage == 'unselected'
          || after.selectedAt == before.selectedAt)
        && (before.stage == 'unselected'
          || after.xpBaselineAtSelection == before.xpBaselineAtSelection)
        && (before.stage == 'unselected'
          || after.hatchXpTarget == before.hatchXpTarget)
        && (before.stage == 'unselected'
          || after.hatchDelayHours == before.hatchDelayHours)
        && (before.stage != 'hatchling'
          || after.petId == before.petId)
        && (before.stage != 'hatchling'
          || after.hatchedAt == before.hatchedAt)
        && (before.stage != 'hatchling'
          || after.petName == before.petName)
        && (before.stage != 'hatchling'
          || after.growthStage == before.growthStage)
        && (before.stage != 'hatchling'
          || after.xpBaselineAtHatch == before.xpBaselineAtHatch)
        && (before.stage != 'hatchling'
          || after.lastEvolutionAt == before.lastEvolutionAt)
        && (after.stage != 'hatchling'
          || before.stage == 'hatchling'
          || (before.stage == 'egg'
            && validCount(engagement.totalXp)
            && engagement.totalXp - before.xpBaselineAtSelection >= before.hatchXpTarget
            && request.time >= before.selectedAt + duration.value(before.hatchDelayHours, 'h')
            && after.growthStage == 'hatchling'
            && after.xpBaselineAtHatch == engagement.totalXp
            && after.lastEvolutionAt == null));
    }

    function validStudyPetWriteUpdate(stateId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['habitatTheme', 'updatedAt'])
        ? validStudyPetHabitatUpdate(stateId)
        : changed.hasOnly(['growthStage', 'xpBaselineAtHatch', 'updatedAt'])
          ? validStudyPetGrowthBaselineUpdate(stateId)
          : changed.hasOnly(['growthStage', 'lastEvolutionAt', 'updatedAt'])
            ? validStudyPetEvolutionUpdate(stateId)
            : (resource.data.stage == 'hatchling'
                && request.resource.data.stage == 'hatchling'
                && changed.hasAny([
                  'growthStage', 'xpBaselineAtHatch', 'lastEvolutionAt'
                ]))
              ? false
              : validStudyPetUpdate(stateId);
    }

    function validStudyPetHabitatUpdate(stateId) {
      return stateId == 'state'
        && validStudyPetState()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['habitatTheme', 'updatedAt'])
        && request.resource.data.updatedAt is timestamp;
    }

    function validStudyPetGrowthBaselineUpdate(stateId) {
      let engagement = get(/databases/$(database)/documents/student_progress/$(request.auth.uid)/engagement/state).data;
      return stateId == 'state'
        && validStudyPetState()
        && resource.data.stage == 'hatchling'
        && request.resource.data.stage == 'hatchling'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['growthStage', 'xpBaselineAtHatch', 'updatedAt'])
        && request.resource.data.growthStage == 'hatchling'
        && request.resource.data.xpBaselineAtHatch == engagement.totalXp
        && request.resource.data.updatedAt is timestamp;
    }

    function validStudyPetEvolutionUpdate(stateId) {
      let engagement = get(/databases/$(database)/documents/student_progress/$(request.auth.uid)/engagement/state).data;
      return stateId == 'state'
        && validStudyPetEvolutionState(request.resource.data)
        && resource.data.stage == 'hatchling'
        && request.resource.data.stage == 'hatchling'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['growthStage', 'lastEvolutionAt', 'updatedAt'])
        && validPetGrowthTransition(resource.data, request.resource.data)
        && validPetGrowthRequirement(request.resource.data, engagement)
        && request.resource.data.xpBaselineAtHatch == resource.data.xpBaselineAtHatch
        && request.resource.data.lastEvolutionAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validChapter() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'chapterNumber', 'title', 'textbookChapterTitle',
          'learningObjectives', 'estimatedMinutes', 'status', 'order',
          'createdAt', 'updatedAt'
        ])
        && data.chapterNumber is int
        && data.chapterNumber > 0
        && data.title is string
        && data.title.size() > 0
        && data.textbookChapterTitle is string
        && data.textbookChapterTitle.size() > 0
        && data.learningObjectives is list
        && data.estimatedMinutes is int
        && data.estimatedMinutes > 0
        && data.status in ['draft', 'active', 'archived']
        && data.order is int
        && data.order >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validModule() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'title', 'type', 'content', 'summary', 'estimatedMinutes',
          'difficulty', 'order', 'status', 'createdAt', 'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.type in [
          'notes', 'flashcards', 'practice', 'quiz', 'test', 'review'
        ]
        && data.content is string
        && data.summary is string
        && data.estimatedMinutes is int
        && data.estimatedMinutes > 0
        && data.difficulty in ['easy', 'medium', 'hard']
        && data.order is int
        && data.order >= 0
        && data.status in ['draft', 'active', 'archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validNoteSection() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'heading', 'body', 'example', 'order', 'createdAt', 'updatedAt'
        ])
        && data.heading is string
        && data.heading.size() > 0
        && data.body is string
        && data.body.size() > 0
        && data.example is string
        && data.order is int
        && data.order >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validFlashcard() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'front', 'back', 'hint', 'order', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.front is string
        && data.front.size() > 0
        && data.back is string
        && data.back.size() > 0
        && data.hint is string
        && data.order is int
        && data.order >= 0
        && data.status in ['draft', 'active', 'archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validPracticeItem() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'question', 'options', 'correctAnswerIndex', 'explanation',
          'hint', 'topic', 'difficulty', 'order', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.question is string
        && data.question.size() > 0
        && data.options is list
        && data.options.size() == 4
        && data.correctAnswerIndex is int
        && data.correctAnswerIndex >= 0
        && data.correctAnswerIndex < data.options.size()
        && data.explanation is string
        && data.explanation.size() > 0
        && data.hint is string
        && data.topic is string
        && data.difficulty in ['easy', 'medium', 'hard']
        && data.order is int
        && data.order >= 0
        && data.status in ['draft', 'active', 'archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validQuizQuestion() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'question', 'options', 'correctOptionIndex', 'explanation',
          'difficulty', 'order', 'status', 'createdAt', 'updatedAt'
        ])
        && data.question is string
        && data.question.size() > 0
        && data.options is list
        && data.options.size() >= 2
        && data.correctOptionIndex is int
        && data.correctOptionIndex >= 0
        && data.correctOptionIndex < data.options.size()
        && data.explanation is string
        && data.explanation.size() > 0
        && data.difficulty in ['easy', 'medium', 'hard']
        && data.order is int
        && data.order >= 0
        && data.status in ['draft', 'active', 'archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Qidah's student app intentionally has no authentication.
    match /students/qidah {
      allow read: if true;
      allow update: if isDashboardAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['preferredLanguage', 'dailyTargetMinutes', 'status'])
        && request.resource.data.preferredLanguage is string
        && request.resource.data.preferredLanguage.size() > 0
        && request.resource.data.dailyTargetMinutes is int
        && request.resource.data.dailyTargetMinutes >= 5
        && request.resource.data.dailyTargetMinutes <= 240
        && request.resource.data.status in ['active', 'paused', 'inactive'];
      allow create, delete: if false;

      match /muffin/state {
        allow read: if true;
        allow write: if false;
      }
    }

    match /student_progress/{uid}/chapters/{chapterProgressId} {
      allow read: if isDashboardAdmin()
        || (isSignedIn() && request.auth.uid == uid);
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && validChapterProgress(uid);
      allow delete: if false;
    }

    match /student_progress/{uid}/saved_flashcards/{savedFlashcardId} {
      allow read: if isDashboardAdmin()
        || (isSignedIn() && request.auth.uid == uid);
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && validSavedFlashcard();
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /student_progress/{uid}/engagement/{stateId} {
      allow read: if isDashboardAdmin()
        || (isSignedIn() && request.auth.uid == uid);
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && stateId == 'state'
        && validEngagementState();
      allow delete: if false;
    }

    match /student_progress/{uid}/engagement_days/{dateKey} {
      allow read: if isDashboardAdmin()
        || (isSignedIn() && request.auth.uid == uid);
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && validEngagementDay(dateKey);
      allow delete: if false;
    }

    match /student_progress/{uid}/pet/{stateId} {
      allow read: if isDashboardAdmin()
        || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && validStudyPetCreate(stateId);
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && validStudyPetWriteUpdate(stateId);
      allow delete: if false;
    }

    match /student_progress/{uid}/pet_economy/{stateId} {
      allow read: if isDashboardAdmin()
        || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && validPetEconomyCreate(stateId);
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && validPetEconomyUpdate(stateId);
      allow delete: if false;
    }

    // `form2` is the current curriculum catalog ID. Future catalogs can use
    // sibling IDs without changing the subjects/chapters/modules structure.
    match /curriculum/form2/subjects/{subjectId} {
      allow read: if true;
      allow write: if false;

      match /chapters/{chapterId} {
        allow read: if true;
        allow create, update: if isDashboardAdmin()
          && subjectId == 'math'
          && validChapter();
        allow delete: if isDashboardAdmin() && subjectId == 'math';

        match /practice_questions/{questionId} {
          allow read: if true;
          allow create, update: if isDashboardAdmin()
            && subjectId == 'math'
            && validPracticeItem();
          allow delete: if isDashboardAdmin() && subjectId == 'math';
        }

        match /modules/{moduleId} {
          allow read: if true;
          allow create, update: if isDashboardAdmin()
            && subjectId == 'math'
            && validModule();
          allow delete: if isDashboardAdmin() && subjectId == 'math';

          match /sections/{sectionId} {
            allow read: if true;
            allow create, update: if isDashboardAdmin()
              && subjectId == 'math'
              && moduleId == 'notes'
              && validNoteSection();
            allow delete: if isDashboardAdmin()
              && subjectId == 'math'
              && moduleId == 'notes';
          }

          match /cards/{cardId} {
            allow read: if true;
            allow create, update: if isDashboardAdmin()
              && subjectId == 'math'
              && moduleId == 'flashcards'
              && validFlashcard();
            allow delete: if isDashboardAdmin()
              && subjectId == 'math'
              && moduleId == 'flashcards';
          }

          match /items/{itemId} {
            allow read: if true;
            allow create, update: if isDashboardAdmin()
              && subjectId == 'math'
              && moduleId == 'practice'
              && validPracticeItem();
            allow delete: if isDashboardAdmin()
              && subjectId == 'math'
              && moduleId == 'practice';
          }

          match /questions/{questionId} {
            allow read: if true;
            allow create, update: if isDashboardAdmin()
              && subjectId == 'math'
              && moduleId == 'quiz'
              && validQuizQuestion();
            allow delete: if isDashboardAdmin()
              && subjectId == 'math'
              && moduleId == 'quiz';
          }
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
